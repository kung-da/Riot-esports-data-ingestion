RIOT_API_KEY=RGAPI-your-api-key
DEFAULT_PLATFORM_REGION=vn2
DEFAULT_ROUTING_REGION=
REGIONS=vn2
REQUEST_TIMEOUT_SECONDS=30
MAX_CONCURRENCY=5
REQUESTS_PER_MINUTE=45
METHOD_REQUESTS_PER_MINUTE=40
REQUEST_SLEEP_MIN_SECONDS=0.8
REQUEST_SLEEP_MAX_SECONDS=1.5
RETRY_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=60
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
TIMELINE_EXTRA_DELAY_SECONDS=2.0
USER_AGENT=RiotDataCrawler/1.0 (Personal Educational Project)
DEFAULT_MATCH_COUNT=10
OVERNIGHT_TARGET_MATCHES=20000
OVERNIGHT_HOURS=8
OVERNIGHT_BATCH_SIZE=1000
OVERNIGHT_BATCH_SLEEP_MIN_SECONDS=480
OVERNIGHT_BATCH_SLEEP_MAX_SECONDS=900
OVERNIGHT_LEADERBOARD_LIMIT_PER_TIER=50
OVERNIGHT_MATCH_COUNT_PER_PUUID=20
OVERNIGHT_INCLUDE_TIMELINES=true
OVERNIGHT_TIERS=CHALLENGER,GRANDMASTER,MASTER,DIAMOND:I
OUTPUT_DIR=output
